# Copy this file to `.env` and adjust the values:  cp .env.example .env
# `.env` is git-ignored. Create React App only exposes variables that start with REACT_APP_
# to the browser bundle and reads them at build/start time (restart `npm start` after changing them).

# Base URL of the REST API (src/constants/api.constants.js).
# The relative path "/api" is forwarded to the backend by the dev server (src/setupProxy.js)
# and by nginx in Docker. Use an absolute URL (e.g. http://localhost:5000/api) only if there is no
# proxy; the backend's CLIENT_URL must then list this app's origin because of CORS.
REACT_APP_API_URL=/api

# Socket.io server URL. Leave empty to use the same origin as the page (proxied as well).
REACT_APP_SOCKET_URL=

# Development only, read by src/setupProxy.js and never sent to the browser:
# where the dev server forwards /api and /socket.io.
# BACKEND_URL=http://127.0.0.1:5000
