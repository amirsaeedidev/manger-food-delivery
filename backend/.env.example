# Copy this file to `.env` and adjust the values:  cp .env.example .env
# `.env` is git-ignored — never commit real secrets.

# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ──────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/restaurant-management

# ── CORS / Socket.io ──────────────────────────────────────────────────────
# Browser origin(s) allowed to call the API, comma separated.
CLIENT_URL=http://localhost:3000

# ── Authentication (JWT) ──────────────────────────────────────────────────
# Use a long random value, e.g.:  openssl rand -hex 32
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# ── SMS (Kavenegar or Smsir) ──────────────────────────────────────────────
# SMS_PROVIDER: kavenegar | smsir
SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
SMSIR_API_KEY=
SMSIR_LINE_NUMBER=

# ── Payment gateway (ZarinPal) ────────────────────────────────────────────
ZARINPAL_MERCHANT_ID=
# Where ZarinPal sends the customer back after payment (example value).
ZARINPAL_CALLBACK_URL=http://localhost:3000/payment/verify
# Use the ZarinPal sandbox while developing. Set to false in production.
ZARINPAL_SANDBOX=true

# ── Email (SMTP) ──────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
